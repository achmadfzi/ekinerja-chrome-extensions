{
  "manifest_version": 3,
  "name": "eKinerja Excel Importer",
  "description": "Import data progress harian dari Excel ke eKinerja BKN secara otomatis. Hemat waktu, tidak perlu input manual!",
  "version": "1.0.0",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "eKinerja Excel Importer"
  },
  "content_scripts": [
    {
      "matches": ["https://kinerja.bkn.go.id/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
